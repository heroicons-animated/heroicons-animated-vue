{
  "name": "@heroicons-animated/vue",
  "version": "1.2.0",
  "description": "Animated Heroicons for Vue, built with Motion for Vue",
  "author": "Aniket-508",
  "license": "MIT",
  "homepage": "https://vue.heroicons-animated.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/heroicons-animated/heroicons-animated-vue"
  },
  "bugs": {
    "url": "https://github.com/heroicons-animated/heroicons-animated-vue/issues"
  },
  "keywords": [
    "heroicons",
    "vue",
    "vue3",
    "icons",
    "animated",
    "motion-v",
    "motion",
    "nuxt"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/icons/*.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "*.js",
    "*.d.ts",
    "README.md"
  ],
  "scripts": {
    "dev": "nuxt dev",
    "build:site": "pnpm run build-registry && nuxt build",
    "build:lib": "vite build -c vite.lib.config.ts && node scripts/generate-proxies.mjs",
    "build": "pnpm run build:lib && pnpm run build:site",
    "preview": "nuxt preview",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "lint:fix-unsafe": "ultracite fix --unsafe",
    "lint:doctor": "ultracite doctor",
    "type-check:site": "nuxt typecheck",
    "type-check:lib": "vue-tsc --noEmit -p tsconfig.lib.json",
    "type-check": "pnpm run type-check:lib && pnpm run type-check:site",
    "build-registry": "node scripts/registry-build.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "peerDependencies": {
    "motion-v": "^1.10.2",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@heroicons/vue": "^2.2.0",
    "@number-flow/vue": "^0.4.9",
    "@nuxt/fonts": "^0.13.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/seo": "^3.4.0",
    "@tailwindcss/vite": "^4.1.18",
    "@toolwind/corner-shape": "0.0.8-3",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "lucide-vue-next": "^0.563.0",
    "motion-v": "^1.10.2",
    "nuxt": "^4.3.0",
    "reka-ui": "^2.8.0",
    "shadcn-nuxt": "2.4.3",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "ultracite": "^7.1.5",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.1.30"
  },
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=10.x"
  },
  "pnpm": {
    "overrides": {
      "confbox": "0.2.2"
    }
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "vue-sonner": "^2.0.9"
  }
}
